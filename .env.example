# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# Never commit `.env` — it holds secrets.

# --- Required ---
# Bot token from the Discord Developer Portal (Bot tab → Reset Token).
DISCORD_TOKEN=
# Anthropic API key for the Claude classifier.
ANTHROPIC_API_KEY=
# Channel ID where officer notices are posted (right-click channel → Copy Channel ID;
# requires Developer Mode enabled in Discord settings).
OFFICER_CHANNEL_ID=

# --- Behavior ---
# Messages are scanned regardless of member join date.
# Comma-separated role IDs that are NEVER scanned (officers, verified members, etc.).
TRUSTED_ROLE_IDS=
# Comma-separated channel IDs to monitor. Leave empty to monitor all text channels.
MONITORED_CHANNEL_IDS=
# Extra spam keywords (comma-separated) appended to the built-in list. Optional.
SPAM_KEYWORDS=

# --- Safety ---
# When true, the bot DETECTS and NOTIFIES officers but does NOT delete or kick.
# Keep DRY_RUN=true for the first few days to tune detection before going live.
DRY_RUN=true

# Claude model used for messages not caught by local spam rules.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
